{
  "name": "agent-builder",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev": "concurrently -n api,web -c green,blue \"npm run dev -w apps/api\" \"npm run dev -w apps/web\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@langchain/community": "^1.1.20",
    "@langchain/core": "^1.1.29",
    "@langchain/openai": "^1.2.11",
    "@supabase/supabase-js": "^2.98.0",
    "langchain": "^1.2.28"
  }
}
